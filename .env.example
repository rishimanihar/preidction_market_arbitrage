# Copy to ~/.config/pmarb/.env (outside the repo) and chmod 600. Key files must also live outside the repo.
# Never paste real values into this file. The app refuses key files inside the repo.

# Data directory is gitignored and stays on this machine.
PMARB_DATA_DIR=./data
# Review app listens on 127.0.0.1.
PMARB_REVIEW_PORT=8501

# Kalshi: API key id + path to the PRIVATE key file (Ed25519 or RSA). Prefer a key with scope "read" only.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=~/.config/pmarb/kalshi_private_key.pem

# Polymarket US: API key id + path to the Ed25519 private key file. Read-only scope if offered.
POLYUS_API_KEY_ID=
POLYUS_PRIVATE_KEY_PATH=~/.config/pmarb/polyus_private_key.pem

# Streams (M2). A venue streams only when BOTH its key id and key path are set and the key
# file passes the key policy (outside the repo, owner-only); otherwise it polls REST. An
# unhealthy stream falls back to REST for that venue until it recovers. Defaults shown.
# PMARB_STREAM_FALLBACK_AFTER_S=5
# PMARB_STREAM_RECOVERY_S=10
# Keep false until a captured Polymarket US frame confirms how many book levels arrive.
# While false, Polymarket US stream results are indicative only, never qualified.
# PMARB_POLYUS_WS_DEPTH_CONFIRMED=false

# Live order submission stays impossible until a separate, later milestone. Do not add trading keys here.
